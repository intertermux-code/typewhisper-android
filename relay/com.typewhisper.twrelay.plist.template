<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template, not a runnable LaunchAgent: launchd has no variable expansion, so
  __HOME__ has to be replaced with your real home directory before install.
  See relay/README.md ("Installed as a LaunchAgent") for the one command that
  does it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.typewhisper.twrelay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/tw-android/relay/tw_relay.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>__HOME__/tw-android/relay</string>
    <key>StandardOutPath</key>
    <string>__HOME__/tw-android/relay/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/tw-android/relay/launchd.err.log</string>
</dict>
</plist>
