<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tw_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/state_idle"
        android:textColor="@color/panel_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/tw_mic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawableStart="@drawable/ic_mic"
        android:drawableTint="@color/panel_text"
        android:text="@string/mic_start" />
</LinearLayout>
